SECRET_KEY=change-me
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# console = prints OTP in server log (dev). msg91 = real SMS
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# true => API also returns the OTP in the response (dev only!)
DEV_RETURN_OTP=true
# Appwrite (server API key needs scopes: rows.read rows.write files.read files.write)
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_BUCKET_ID=issue-photos
APPWRITE_API_KEY=
# Push notifications (Firebase Cloud Messaging). Paste the Firebase service-account JSON (one line, or base64 of it).
FCM_SERVICE_ACCOUNT=
REWARD_PER_POST=33
